# Production build served BY the FastAPI backend on the same origin.
# Empty value => the web app calls the API with relative paths (/login,
# /animales/, ...), so app + API share one host and one HTTPS tunnel, with
# no CORS to configure.
#
# If you ever host the frontend separately (e.g. Netlify) instead of letting
# the backend serve it, override this in that platform's env settings with the
# full backend URL, e.g. VITE_API_BASE_URL=https://your-api.example.com
VITE_API_BASE_URL=
